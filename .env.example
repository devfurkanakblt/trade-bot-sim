PUSHBULLET_TOKEN=your-pushbullet-access-token-here
MARKET_DATA_BASE_URL=https://data-api.binance.vision
PUSHBULLET_API_URL=https://api.pushbullet.com/v2/pushes
# Set only when both URLs point at the authenticated Cloudflare proxy.
OUTBOUND_PROXY_TOKEN=
DB_PATH=trade_bot_sim.db
KLINE_INTERVAL=1m
# Highest-volume USDT pairs to scan. Set to 0 for every eligible USDT market.
MARKET_UNIVERSE_SIZE=50
MARKET_UNIVERSE_REFRESH_SECONDS=900
BACKUP_DIR=backups
BACKUP_KEEP=14
